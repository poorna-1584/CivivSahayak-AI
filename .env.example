# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Configurable Gemini models for RAG and Chat
GEMINI_CHAT_MODEL="gemini-3.8-flash"
GEMINI_EMBED_MODEL="gemini-embedding-2"

# SQLite persistent storage path
DATABASE_PATH="./data/civicsahayak.db"

# Admin authentication settings (change before production deployment)
ADMIN_EMAIL="admin@civicsahayak.gov.in"
ADMIN_PASSWORD="CivicAdmin@2026"
SESSION_SECRET="replace-with-strong-random-secret-in-production"

# Server port (AI Studio uses 3000)
PORT=3000
